# Copy to a private .env, replace placeholders, and export variables explicitly.
# The application does not load dotenv files. Never commit your filled-in copy.
SRE_JIRA_BASE_URL='https://your-site.atlassian.net'
SRE_JIRA_EMAIL='you@example.invalid'
SRE_JIRA_API_TOKEN='replace-in-private-environment'
SRE_JIRA_PROJECT='DEMO'
# An optional multiline Jira text field containing the version 2 JSON contract.
SRE_JIRA_CONTRACT_FIELD='customfield_12345'
SRE_JIRA_DONE_STATUSES='Done'
SRE_JIRA_WRITES_ENABLED='false'
# Planning only; distinct from execution/report/transition authorization.
SRE_JIRA_ISSUE_TYPE_ID='10001'
SRE_JIRA_PLANNING_WRITES_ENABLED='false'

SRE_EVIDENCE_API_URL='https://evidence.example.invalid'
# Only for the local loopback HTTPS host; no global trust-store changes.
# SRE_EVIDENCE_CA_FILE='/absolute/private/pilot/server.crt'
SRE_EVIDENCE_API_TOKEN='replace-with-exact-scope-service-token'
# Pilot setup only: separate controller with exact-scope preview:register grant.
# Do not provide this token to the engineering worker process.
SRE_PILOT_SETUP_TOKEN='replace-with-separate-controller-token'
SRE_REPOSITORY='example/demo-service'
SRE_REPO_DIR='/absolute/path/to/approved/source-checkout'
# Durable, private, shared by workers; outside the source checkout; mode 0700.
SRE_WORK_ROOT='/absolute/path/to/private/execution-journal'
SRE_ALLOWED_FILES_JSON='["app.py","test_app.py"]'
# Python 3.11 image used by the synthetic tests. Your image must contain your test tools.
# Pull the approved digest explicitly before running; the worker never pulls images.
SRE_TEST_IMAGE='python@sha256:65bd3d9f1d7fa268dd1909973ba7eb4bdf41f6dcf2cfbe76ba9528b170f3fd79'
SRE_TEST_COMMAND_JSON='["python","-m","unittest","discover","-v"]'
SRE_WORKER_TIMEOUT_SECONDS='300'

# CLI flags checked with Claude Code 2.1.319. Install the CLI separately.
SRE_CLAUDE_BINARY='/absolute/path/to/claude'
SRE_CLAUDE_MODEL='replace-with-approved-model-id'
ANTHROPIC_API_KEY='replace-in-private-environment'
SRE_CLAUDE_ENABLED='false'
# CLI estimate per invocation; this is not an exact billing cap.
SRE_CLAUDE_BUDGET_USD='2'

# Existing Temporal service. Non-loopback endpoints require TLS.
SRE_TEMPORAL_ADDRESS='127.0.0.1:7233'
SRE_TEMPORAL_NAMESPACE='default'
SRE_TEMPORAL_TASK_QUEUE='sre-engineering-v1'
SRE_TEMPORAL_TLS='false'
# Export only if required by the configured service; do not use a placeholder token.
# SRE_TEMPORAL_API_KEY='replace-in-private-environment'

# Optional reviewed-candidate publication to SRE_REPOSITORY on github.com only.
# Token: repository Contents + Pull requests read/write, scoped to that repository.
SRE_GITHUB_PRS_ENABLED='false'
SRE_GITHUB_TOKEN='replace-in-private-environment'
SRE_GITHUB_BASE_BRANCH='main'

# Status transitions additionally require Jira writes and GitHub PRs enabled.
# Replace ALL IDs with your workflow IDs; these numbers are synthetic examples.
# Targets must be distinct nonterminal statuses. No Done/Accepted transition exists.
SRE_JIRA_TRANSITIONS_ENABLED='false'
SRE_JIRA_TRANSITIONS_JSON='{"in_progress":{"transition_id":"10","status_id":"200","from_status_ids":["100"]},"in_review":{"transition_id":"20","status_id":"300","from_status_ids":["200"]},"blocked":{"transition_id":"30","status_id":"400","from_status_ids":["200"]}}'

# Read-only diagnosis after exporting this file (does not enable any flags):
# python -m sre_suite.execution.cli preflight examples/execution.json
# Exit 1: blocked. Exit 2: read checks passed; write/inference capabilities unverified.

# Explicit telemetry collector only; never forward these credentials to model workers.
# Complete Basic or Bearer headers. Configure real read-only credentials privately.
# See docs/telemetry-adapters.md for reviewed scope mappings and exact preview grants.
SRE_TELEMETRY_PROMETHEUS_AUTH='Bearer replace-in-private-environment'
SRE_TELEMETRY_LOKI_AUTH='Bearer replace-in-private-environment'
SRE_TELEMETRY_TEMPO_AUTH='Bearer replace-in-private-environment'
SRE_TELEMETRY_LOKI_TENANT='replace-in-private-environment'
SRE_TELEMETRY_TEMPO_TENANT='replace-in-private-environment'

# Separate, explicitly started finite telemetry workflow worker.
SRE_TELEMETRY_TASK_QUEUE='sre-telemetry-v1'

# Optional engineering telemetry: a private reviewed configuration authorizes finite
# collection and evidence uploads after all four stages when you explicitly start a run.
# Leave unset to retain the original engineering-only workflow. See docs/engineering-telemetry.md.
# SRE_ENGINEERING_TELEMETRY_CONFIG='/absolute/private/engineering-telemetry.json'

# Separate explicitly started certification worker; use its own verifier evidence token.
SRE_CERTIFICATION_TASK_QUEUE='sre-certification-v1'
# See docs/certification.md for reviewed policy, source mappings and independent fixtures.
